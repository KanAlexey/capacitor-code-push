{
  "name": "capacitor-code-push",
  "version": "0.1.0",
  "description": "CodePush client for Capacitor apps: over-the-air web updates from a CodePush-compatible server such as Revopush",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "author": "Aleksei Kan <kang.alexey96@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanAlexey/capacitor-code-push.git"
  },
  "bugs": {
    "url": "https://github.com/KanAlexey/capacitor-code-push/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "codepush",
    "code-push",
    "revopush",
    "ota",
    "live-update"
  ],
  "scripts": {
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "docgen": "docgen --api CodePushPlugin --output-readme README.md --output-json dist/docs.json",
    "test": "vitest run",
    "test:unit:coverage": "vitest run --coverage && node test/coverage/summarize.mjs js",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "test:android": "cd android && ./gradlew test",
    "test:android:coverage": "cd android && ./gradlew createDebugUnitTestCoverageReport && cd .. && node test/coverage/summarize.mjs android",
    "test:ios": "cd test/ios && xcodebuild test -scheme CodePushCoreTests-Package -destination \"platform=iOS Simulator,id=$(node simulator.mjs --udid)\" -skipPackagePluginValidation",
    "test:ios:coverage": "cd test/ios && ./coverage.sh && cd ../.. && node test/coverage/summarize.mjs ios",
    "test:e2e:ios": "node test/e2e/run-ios.mjs",
    "test:e2e:android": "node test/e2e/run-android.mjs",
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme CapacitorCodePush -destination generic/platform=iOS",
    "verify:android": "cd android && ./gradlew clean build && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint .",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "homepage": "https://github.com/KanAlexey/capacitor-code-push#readme"
}
